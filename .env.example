# ===== LLM（主力 DeepSeek，OpenAI 兼容）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 备用模型（Spike 阶段暂不使用，仅预留）
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# ===== 成本单价（元 / 百万 token）=====
# 默认值取自 DeepSeek 官方 V3.2 定价，使用前请到官网核对，改这里即可全局生效
PRICE_LLM_INPUT_CACHE_HIT=0.5
PRICE_LLM_INPUT_CACHE_MISS=2.0
PRICE_LLM_OUTPUT=8.0

# ===== Embedding（SiliconFlow BGE-M3，Spike 阶段仅验证 Key）=====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 搜索（Tavily 优先，博查兜底）=====
TAVILY_API_KEY=
BOCHA_API_KEY=

# ===== 网页正文（Jina Reader 优先，trafilatura 兜底；Jina Key 可选）=====
JINA_API_KEY=

# ===== Spike 预算上限（硬限制，防止跑飞）=====
SPIKE_MAX_SEARCH_QUERIES=8
SPIKE_MAX_PAGES=15
# 单页正文截断长度（字符）
SPIKE_MAX_PAGE_CHARS=12000
